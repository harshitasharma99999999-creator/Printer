# Copy to .env only for local development. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ElevenLabs voice adapter
VOICE_API_KEY=
VOICE_ID=EXAVITQu4vr4xnSDxMaL
VOICE_MODEL_ID=eleven_multilingual_v2

# HeyGen avatar adapter. Set a female presenter avatar ID from your account.
AVATAR_API_KEY=
AVATAR_ID=
AVATAR_MODE=auto

# YouTube OAuth 2.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public

# Instagram professional account (Business or Creator)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=v23.0
INSTAGRAM_MODE=auto

# Last-resort Instagram fallback. This uses an unofficial/private API and can
# trigger checkpoints, temporary locks, or account disablement.
INSTAGRAM_PROVIDER=instagrapi
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_JSON=

# Runtime controls
DRY_RUN=true
ALLOW_GENERATION_FALLBACK=true
OUTPUT_DIR=output
LOG_DIR=logs
